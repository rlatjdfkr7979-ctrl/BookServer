// =============================================================
// ✅ Google Books 검색 프록시 (API 키를 서버에 숨김)
//    - 스크립트 속성 GOOGLE_BOOKS_API_KEY 필요
//    - 같은 검색어는 6시간 캐시
// =============================================================
function searchBooks(query) {
  try {
    const q = String(query || '').trim().slice(0, 200);
    if (!q) return { success: false, error: '검색어가 없습니다.' };

    const cache = CacheService.getScriptCache();
    const cacheKey = 'gb_' + Utilities.base64EncodeWebSafe(
      Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, q)
    );
    const cached = cache.get(cacheKey);
    if (cached) return JSON.parse(cached);

    const key = PropertiesService.getScriptProperties().getProperty('GOOGLE_BOOKS_API_KEY');
    if (!key) return { success: false, error: 'GOOGLE_BOOKS_API_KEY가 설정되지 않았습니다.' };

    const url = 'https://www.googleapis.com/books/v1/volumes'
      + '?q=' + encodeURIComponent(q)
      + '&maxResults=10&langRestrict=ko'
      + '&country=KR' // 서버 호출은 사용자 위치를 알 수 없어 403 unknownLocation이 나므로 국가 지정
      + '&key=' + encodeURIComponent(key);
    const res = UrlFetchApp.fetch(url, { muteHttpExceptions: true });
    if (res.getResponseCode() !== 200) {
      // 구글이 알려주는 실패 사유(reason/message)를 함께 반환 (키 값은 노출하지 않음)
      let detail = '';
      try {
        const err = JSON.parse(res.getContentText()).error || {};
        const reason = (err.errors && err.errors[0] && err.errors[0].reason) || err.status || '';
        detail = ' [' + reason + '] ' + String(err.message || '').slice(0, 200);
      } catch (ignore) {}
      Logger.log('🚨 Google Books 응답: ' + res.getResponseCode() + ' ' + res.getContentText().slice(0, 500));
      return { success: false, error: 'Google Books HTTP ' + res.getResponseCode() + detail };
    }

    const result = { success: true, items: JSON.parse(res.getContentText()).items || [] };
    const text = JSON.stringify(result);
    if (text.length < 90000) cache.put(cacheKey, text, 21600); // 캐시 항목 한도(100KB) 이내일 때만
    return result;
  } catch (err) {
    Logger.log('🚨 searchBooks 오류: ' + err);
    return { success: false, error: err.toString() };
  }
}

// =============================================================
// ✅ 대출 상태 계산 (books.csv + library.csv → 도서코드별 현재 상태)
//    - 프론트(main.js)와 같은 규칙: 코드별 마지막 이력 기준,
//      대출 기간 30일(전공·자격증·어학은 90일), '연장' 1회당 대출 기간만큼 추가
//    - 파일 읽기는 GitHub API (스크립트 속성 GITHUB_TOKEN 사용)
// =============================================================
const GITHUB_REPO_ = 'rlatjdfkr7979-ctrl/BookServer';
const MAX_EXTENSIONS_ = 1;      // 대출 연장 가능 횟수
const REMIND_BEFORE_DAYS_ = 3;  // 반납 예정 며칠 전에 안내할지

function githubGetFile_(path) {
  const url = 'https://api.github.com/repos/' + GITHUB_REPO_ + '/contents/' + path + '?ref=main';
  const res = UrlFetchApp.fetch(url, { headers: { Authorization: 'token ' + getGithubToken_() } });
  const json = JSON.parse(res.getContentText());
  const text = Utilities.newBlob(Utilities.base64Decode(json.content)).getDataAsString('UTF-8');
  return { text: text, sha: json.sha };
}

function csvCol_(header, names) {
  return header.findIndex(function (h) {
    const t = String(h).replace(/﻿/g, '').replace(/\s/g, '');
    return names.some(function (n) { return t.indexOf(n) !== -1; });
  });
}

function parseYmdUtc_(s) {
  const m = String(s || '').match(/^(\d{4})\s*[-./]\s*(\d{1,2})\s*[-./]\s*(\d{1,2})/);
  return m ? Date.UTC(+m[1], +m[2] - 1, +m[3]) : NaN;
}

function formatYmdUtc_(ms) {
  return Utilities.formatDate(new Date(ms), 'UTC', 'yyyy-MM-dd');
}

function getLoanStates_(booksText, libraryText) {
  const DAY = 86400000;
  const books = Utilities.parseCsv(booksText.replace(/^﻿/, ''));
  const lib = Utilities.parseCsv(libraryText.replace(/^﻿/, ''));

  // 도서 정보 (제목/장르)
  const lh = lib[0];
  const lCode = csvCol_(lh, ['코드']), lTitle = csvCol_(lh, ['제목', '도서명']), lGenre = csvCol_(lh, ['장르']);
  const info = {};
  for (let i = 1; i < lib.length; i++) {
    const code = String(lib[i][lCode] || '').trim();
    if (code) info[code] = { title: lib[i][lTitle] || '', genre: lGenre === -1 ? '' : (lib[i][lGenre] || '') };
  }

  // 코드별 마지막 이력 반영
  const bh = books[0];
  const bDate = csvCol_(bh, ['등록일', '대출일', '일자']), bCode = csvCol_(bh, ['코드']);
  const bTitle = csvCol_(bh, ['도서명', '제목']), bAuthor = csvCol_(bh, ['저자']);
  const bUser = csvCol_(bh, ['대여자', '대출자']), bStatus = csvCol_(bh, ['상태']);
  const states = {};
  for (let i = 1; i < books.length; i++) {
    const r = books[i];
    const code = String(r[bCode] || '').trim();
    if (!code) continue;
    const status = String(r[bStatus] || '').trim();
    const prev = states[code];
    if (status.indexOf('반납') !== -1) {
      states[code] = { returned: true };
    } else if (status.indexOf('연장') !== -1 && prev && !prev.returned) {
      prev.extensions += 1;
      if (r[bUser]) prev.borrower = String(r[bUser]).trim();
    } else {
      states[code] = {
        returned: false,
        loanDate: String(r[bDate] || '').trim(),
        borrower: String(r[bUser] || '').trim(),
        title: r[bTitle] || '',
        author: r[bAuthor] || '',
        extensions: 0
      };
    }
  }

  // 반납 예정일/남은 일수 계산
  const todayMs = parseYmdUtc_(Utilities.formatDate(new Date(), 'Asia/Seoul', 'yyyy-MM-dd'));
  Object.keys(states).forEach(function (code) {
    const s = states[code];
    s.code = code;
    if (s.returned) return;
    const meta = info[code] || { title: '', genre: '' };
    if (!s.title) s.title = meta.title;
    s.period = String(meta.genre).indexOf('전공·자격증·어학') !== -1 ? 90 : 30;
    const loanMs = parseYmdUtc_(s.loanDate);
    if (isNaN(loanMs)) { s.remaining = null; return; }
    const totalDays = s.period * (1 + s.extensions);
    const elapsed = Math.round((todayMs - loanMs) / DAY);
    s.remaining = totalDays - elapsed;           // 음수면 연체
    s.dueDate = formatYmdUtc_(loanMs + totalDays * DAY);
  });
  return states;
}

// =============================================================
// ✅ 반납 예정/연체 안내 DM (시간 기반 트리거로 매일 실행)
//    - 반납 예정 3일 전, 반납 당일: 대출자에게 DM
//    - 연체: 1일째, 이후 7일마다 대출자에게 DM
//    - 월요일마다 연체 목록을 도서 담당자(스크립트 속성 BOOK_MANAGER_NAME)에게 DM
//    - 트리거 등록은 installDailyTrigger()를 한 번 실행
// =============================================================
function sendDueReminders() {
  const books = githubGetFile_('books.csv');
  const lib = githubGetFile_('library.csv');
  const states = getLoanStates_(books.text, lib.text);

  let sent = 0, failed = 0;
  const overdueList = [];
  Object.keys(states).forEach(function (code) {
    const s = states[code];
    if (s.returned || s.remaining === null || s.remaining === undefined || !s.borrower) return;

    let text = null;
    if (s.remaining === REMIND_BEFORE_DAYS_) {
      text = '[반납 예정 안내] "' + s.title + '" 도서의 반납 예정일은 ' + s.dueDate + '입니다 (' + REMIND_BEFORE_DAYS_ + '일 남음).'
        + (s.extensions < MAX_EXTENSIONS_ ? '\n필요하면 도서관리 시스템에서 1회 대출 연장이 가능합니다.' : '');
    } else if (s.remaining === 0) {
      text = '[반납 예정 안내] "' + s.title + '" 도서의 반납일이 오늘(' + s.dueDate + ')입니다.';
    } else if (s.remaining < 0) {
      const od = -s.remaining;
      overdueList.push({ title: s.title, borrower: s.borrower, days: od });
      if (od === 1 || od % 7 === 0) {
        text = '[연체 안내] "' + s.title + '" 도서가 ' + od + '일 연체되었습니다 (반납 예정일 ' + s.dueDate + '). 가급적 빨리 반납해 주세요. 🙏';
      }
    }
    if (!text) return;
    const dm = sendDoorayDM_(s.borrower, text);
    if (dm.success) sent++; else { failed++; Logger.log('⚠️ 안내 DM 실패 (' + s.borrower + '): ' + dm.error); }
  });

  // 월요일: 담당자에게 연체 목록 요약
  const manager = PropertiesService.getScriptProperties().getProperty('BOOK_MANAGER_NAME');
  const isMonday = Utilities.formatDate(new Date(), 'Asia/Seoul', 'u') === '1';
  if (manager && isMonday && overdueList.length > 0) {
    overdueList.sort(function (a, b) { return b.days - a.days; });
    const lines = overdueList.slice(0, 30).map(function (o) {
      return '• ' + o.title + ' / ' + o.borrower + ' / ' + o.days + '일';
    });
    const more = overdueList.length > 30 ? '\n… 외 ' + (overdueList.length - 30) + '건' : '';
    sendDoorayDM_(manager, '[연체 도서 현황] 총 ' + overdueList.length + '건\n' + lines.join('\n') + more);
  }

  Logger.log('📬 반납/연체 안내 완료: 발송 ' + sent + '건, 실패 ' + failed + '건, 연체 ' + overdueList.length + '건');
  return { sent: sent, failed: failed, overdue: overdueList.length };
}

// 매일 오전 9시(한국 시간)에 sendDueReminders 실행 - Apps Script 편집기에서 한 번만 실행
function installDailyTrigger() {
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (t.getHandlerFunction() === 'sendDueReminders') ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger('sendDueReminders').timeBased().everyDays(1).atHour(9).inTimezone('Asia/Seoul').create();
  Logger.log('✅ 매일 09시 sendDueReminders 트리거 등록 완료');
}

// =============================================================
// ✅ 대출 연장 (books.csv에 '연장' 행을 추가)
//    - 조건: 현재 대출 중, 대출자 이름 일치, 연체 아님, 예약 대기자 없음, 연장 횟수 미초과
//    - 연장 시 대출 기간(30/90일)만큼 반납 예정일이 늘어남
// =============================================================
function extendLoan(bookCode, borrowerName) {
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(30000);
    const code = String(bookCode || '').trim();
    const name = String(borrowerName || '').trim();
    if (!code || !name) return { success: false, error: '도서코드와 대출자 이름은 필수입니다.' };

    const books = githubGetFile_('books.csv');
    const lib = githubGetFile_('library.csv');
    const s = getLoanStates_(books.text, lib.text)[code];

    if (!s || s.returned) return { success: false, error: '현재 대출 중인 도서가 아닙니다.' };
    if (s.borrower !== name) return { success: false, error: '대출자 이름이 일치하지 않습니다.' };
    if (s.extensions >= MAX_EXTENSIONS_) return { success: false, error: '이미 연장한 도서입니다. (연장은 ' + MAX_EXTENSIONS_ + '회까지 가능)' };
    if (s.remaining === null || s.remaining === undefined) return { success: false, error: '대출일을 확인할 수 없어 연장할 수 없습니다.' };
    if (s.remaining < 0) return { success: false, error: '연체 중인 도서는 연장할 수 없습니다. 먼저 반납해 주세요.' };

    const res = getReservationsByCode(code);
    const waiting = (res.success ? res.data : []).filter(function (r) { return r.status === '대기'; });
    if (waiting.length > 0) return { success: false, error: '예약 대기자가 있어 연장할 수 없습니다.' };

    // books.csv에 '연장' 행 추가 (등록일,도서코드,도서명,저자명,대여자명,상태)
    const now = Utilities.formatDate(new Date(), 'Asia/Seoul', 'yyyy-MM-dd HH:mm:ss');
    const line = [now, code, s.title, s.author, s.borrower, '연장']
      .map(function (v) { return '"' + String(v == null ? '' : v).replace(/"/g, '""') + '"'; }).join(',');
    const newline = books.text.indexOf('\r\n') !== -1 ? '\r\n' : '\n';
    const newCsv = books.text.replace(/(\r\n|\n|\r)+$/, '') + newline + line;

    const url = 'https://api.github.com/repos/' + GITHUB_REPO_ + '/contents/books.csv?ref=main';
    UrlFetchApp.fetch(url, {
      method: 'put',
      headers: { Authorization: 'token ' + getGithubToken_(), 'Content-Type': 'application/json' },
      payload: JSON.stringify({
        message: 'Append new loan record to books.csv',
        content: Utilities.base64Encode(Utilities.newBlob(newCsv, 'text/csv', 'books.csv').getBytes()),
        sha: books.sha,
        branch: 'main'
      })
    });

    const newDue = formatYmdUtc_(parseYmdUtc_(s.loanDate) + s.period * (1 + s.extensions + 1) * 86400000);
    Logger.log('✅ 대출 연장 완료: ' + code + ' / ' + name + ' → ' + newDue);
    return { success: true, date: now, dueDate: newDue, extensions: s.extensions + 1 };
  } catch (err) {
    Logger.log('🚨 extendLoan 오류: ' + err);
    return { success: false, error: err.toString() };
  } finally {
    lock.releaseLock();
  }
}
